{
  "name": "value-investing-corner",
  "private": true,
  "scripts": {
    "dev": "corepack pnpm --filter @value-investing/web dev",
    "dev:web": "corepack pnpm --filter @value-investing/web dev",
    "dev:desktop": "corepack pnpm --filter @value-investing/desktop tauri dev",
    "dev:desktop:web": "corepack pnpm --filter @value-investing/desktop dev",
    "build": "corepack pnpm --filter @value-investing/web build",
    "build:web": "corepack pnpm --filter @value-investing/web build",
    "build:desktop": "corepack pnpm --filter @value-investing/desktop build",
    "bundle:desktop": "corepack pnpm --filter @value-investing/desktop tauri build",
    "start": "corepack pnpm --filter @value-investing/web start",
    "search:export": "corepack pnpm --filter @value-investing/web search:export",
    "search:sync": "corepack pnpm --filter @value-investing/web search:sync",
    "search:test": "corepack pnpm --filter @value-investing/web search:test",
    "types:check": "corepack pnpm -r types:check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "corepack pnpm lint && corepack pnpm types:check",
    "check:fix": "biome check --write .",
    "check:local": "node scripts/verify-local.mjs check",
    "build:web:local": "node scripts/verify-local.mjs build",
    "test": "node --test scripts/workspace.test.mjs scripts/verify-local.test.mjs && corepack pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "tsx": "^4.20.0"
  },
  "packageManager": "pnpm@12.14.0"
}
